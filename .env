APP_NAME=Swipee
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Database configuration
# Set to 'mysql' to use XAMPP MySQL, or 'sqlite' for zero-setup local database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=swipee
DB_USERNAME=root
DB_PASSWORD=root

USE_SQLITE_FALLBACK=true

# Try-on driver (pollinations, stub, photoroom)
TRYON_DRIVER=pollinations
